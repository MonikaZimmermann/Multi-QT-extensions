# All agent code, experiments, papers, results, and scratch files stay local.
/agent/

# Quarto / LaTeX intermediates
.quarto/
slides/multivariate_calibration.tex
slides/multivariate_calibration_files/
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
# PDFs: the workflow plots directly in output/pdf/ (base cmu_submission) and
# output/windowed_seasonal/pdf/ (base windowed_seasonal) are tracked. The plots in their
# subfolders (about 240 MB) are committed only at milestones: git add -f the folders,
# commit, then git rm -r --cached them in the next commit.
*.pdf
!/output/pdf/*.pdf
!/output/windowed_seasonal/pdf/*.pdf
!/notes/*.pdf
*.png
*.csv
*.md
*.rds

# Local rendering checks
tmp/

# Delphi code, pinned packages and caches downloaded by R/00_base_forecasts.R.
/external/
